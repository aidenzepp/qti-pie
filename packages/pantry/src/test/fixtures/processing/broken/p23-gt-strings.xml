<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0_v1p0.xsd" identifier="p23-gt-strings" title="P23: qti-gt over strings" adaptive="false" time-dependent="false">
    <qti-response-declaration identifier="RESPONSE" cardinality="single" base-type="identifier">
        <qti-correct-response>
            <qti-value>ChoiceA</qti-value>
        </qti-correct-response>
    </qti-response-declaration>
    <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float">
        <qti-default-value>
            <qti-value>0</qti-value>
        </qti-default-value>
    </qti-outcome-declaration>
    <qti-outcome-declaration identifier="COUNT" cardinality="single" base-type="integer"/>
    <qti-outcome-declaration identifier="FLAG" cardinality="single" base-type="boolean"/>
    <qti-outcome-declaration identifier="NOTE" cardinality="single" base-type="string"/>
    <qti-outcome-declaration identifier="PICK" cardinality="single" base-type="identifier"/>
    <qti-outcome-declaration identifier="BAG" cardinality="multiple" base-type="identifier"/>
    <qti-outcome-declaration identifier="NUMS" cardinality="multiple" base-type="float"/>
    <qti-outcome-declaration identifier="TAKEN" cardinality="single" base-type="duration"/>
    <qti-outcome-declaration identifier="REC" cardinality="record"/>
    <qti-item-body>
        <qti-choice-interaction response-identifier="RESPONSE" shuffle="false" max-choices="1">
            <qti-simple-choice identifier="ChoiceA">First</qti-simple-choice>
            <qti-simple-choice identifier="ChoiceB">Second</qti-simple-choice>
        </qti-choice-interaction>
    </qti-item-body>
    <qti-response-processing>
        <qti-set-outcome-value identifier="FLAG">
            <qti-gt>
                <qti-variable identifier="NOTE"/>
                <qti-base-value base-type="string">alpha</qti-base-value>
            </qti-gt>
        </qti-set-outcome-value>
    </qti-response-processing>
</qti-assessment-item>
