<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0_v1p0.xsd" identifier="p25-number-correct-in-template" title="P25: qti-number-correct in template processing" adaptive="false" time-dependent="false">
    <qti-context-declaration identifier="CTX" cardinality="single" base-type="integer">
        <qti-default-value>
            <qti-value>1</qti-value>
        </qti-default-value>
    </qti-context-declaration>
    <qti-response-declaration identifier="RESPONSE" cardinality="single" base-type="integer"/>
    <qti-template-declaration identifier="N" cardinality="single" base-type="integer"/>
    <qti-template-declaration identifier="M" cardinality="single" base-type="integer"/>
    <qti-template-processing>
        <qti-set-template-value identifier="N">
            <qti-number-correct/>
        </qti-set-template-value>
    </qti-template-processing>
    <qti-item-body>
        <p>Enter a number.</p>
        <p>
            <qti-text-entry-interaction response-identifier="RESPONSE" base="10"/>
        </p>
    </qti-item-body>
</qti-assessment-item>
