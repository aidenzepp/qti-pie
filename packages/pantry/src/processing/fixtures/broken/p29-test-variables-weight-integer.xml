<?xml version="1.0" encoding="UTF-8"?>
<qti-outcome-processing xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0_v1p0.xsd">
    <!-- Test environment this tree is checked under: COUNT integer single. SCORE and WEIGHT are item-level outcomes of the test's items. -->
    <qti-set-outcome-value identifier="COUNT">
        <qti-sum>
            <qti-test-variables variable-identifier="SCORE" weight-identifier="WEIGHT" base-type="integer"/>
        </qti-sum>
    </qti-set-outcome-value>
</qti-outcome-processing>
