{
  "name": "@qti-pie/plate",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#plate/*": "./src/*",
    "#scripts/*": "./scripts/*"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "ledger": "node scripts/ledger.ts",
    "serve": "node scripts/serve.ts",
    "test": "mkdir -p work/.vp-tmp && TMPDIR=\"$PWD/work/.vp-tmp\" NODE_OPTIONS=\"$NODE_OPTIONS --disable-proto=delete --disable-sigusr1\" vp test run"
  },
  "dependencies": {
    "@qti-pie/crust": "workspace:*",
    "effect": "4.0.7"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.7",
    "parse5": "8.0.1",
    "vitest": "5.0.1"
  }
}
