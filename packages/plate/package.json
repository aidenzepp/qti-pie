{
  "name": "@qti-pie/plate",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#plate/*": "./src/*",
    "#scripts/*": "./scripts/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx",
    "./runtime": "./src/runtime.dom.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "browsers": "PLAYWRIGHT_BROWSERS_PATH=\"$HOME/.cache/gr8des/ms-playwright\" playwright-core install --only-shell chromium webkit",
    "host:astro": "node scripts/astro-server.ts",
    "ledger": "node scripts/ledger.ts",
    "serve": "node scripts/serve.ts",
    "test": "mkdir -p work/.vp-tmp && TMPDIR=\"$PWD/work/.vp-tmp\" NODE_OPTIONS=\"$NODE_OPTIONS --disable-proto=delete --disable-sigusr1\" vp test run",
    "test:browser": "mkdir -p work/.vp-tmp && TMPDIR=\"$PWD/work/.vp-tmp\" PLAYWRIGHT_BROWSERS_PATH=\"$HOME/.cache/gr8des/ms-playwright\" NODE_OPTIONS=\"$NODE_OPTIONS --disable-proto=delete --disable-sigusr1\" vp test run --config vite.browser.config.ts"
  },
  "dependencies": {
    "@qti-pie/crust": "workspace:*",
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@astrojs/node": "11.1.9",
    "@effect/vitest": "4.1.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "astro": "7.4.2",
    "parse5": "8.0.1",
    "playwright": "1.64.1",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
