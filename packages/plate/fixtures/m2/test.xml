<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-test xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0p1_v1p0.xsd"
  identifier="m2-test" title="Numbers check">
  <qti-test-part identifier="P1" navigation-mode="nonlinear" submission-mode="simultaneous">
    <qti-item-session-control allow-review="true" show-solution="true"/>
    <qti-assessment-section identifier="S1" title="Counting and choosing" visible="true">
      <qti-assessment-item-ref identifier="p1-single-choice" href="items/p1-single-choice.xml"/>
      <qti-assessment-item-ref identifier="p1-text-entry" href="items/p1-text-entry.xml"/>
      <qti-assessment-item-ref identifier="p1-multiple-choice" href="items/p1-multiple-choice.xml"/>
    </qti-assessment-section>
  </qti-test-part>
  <qti-test-part identifier="P2" navigation-mode="linear" submission-mode="simultaneous">
    <qti-assessment-section identifier="S2" title="Looking back" visible="true">
      <qti-assessment-item-ref identifier="p2-extended-text" href="items/p2-extended-text.xml"/>
      <qti-assessment-item-ref identifier="p2-choice" href="items/p2-choice.xml"/>
    </qti-assessment-section>
  </qti-test-part>
</qti-assessment-test>
