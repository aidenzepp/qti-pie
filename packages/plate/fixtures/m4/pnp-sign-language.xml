<?xml version="1.0" encoding="UTF-8"?>
<!-- A hand-written AfA PNP 3.0 profile that assigns sign language in American Sign Language (ase) and names it in activate-at-initialization-set, so it is on at the start of the delivery. -->
<access-for-all-pnp xmlns="http://www.imsglobal.org/xsd/qti/qtiv3p0/imsafa3p0pnp_v1p0">
  <sign-language xml:lang="ase"/>
  <activate-at-initialization-set>
    <sign-language/>
  </activate-at-initialization-set>
</access-for-all-pnp>
