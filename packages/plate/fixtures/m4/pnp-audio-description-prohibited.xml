<?xml version="1.0" encoding="UTF-8"?>
<!-- The profile of pnp-audio-description.xml with audio description also named in prohibit-set, which wins over the assignment and the initialization set. -->
<access-for-all-pnp xmlns="http://www.imsglobal.org/xsd/qti/qtiv3p0/imsafa3p0pnp_v1p0">
  <audio-description/>
  <activate-at-initialization-set>
    <audio-description/>
  </activate-at-initialization-set>
  <prohibit-set>
    <audio-description/>
  </prohibit-set>
</access-for-all-pnp>
