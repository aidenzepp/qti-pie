<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0p1_v1p0.xsd"
  identifier="m4-answer-masking" title="Answer masking" adaptive="false" time-dependent="false">
  <qti-response-declaration identifier="ANIMAL" cardinality="single" base-type="identifier">
    <qti-correct-response>
      <qti-value>DOLPHIN</qti-value>
    </qti-correct-response>
  </qti-response-declaration>
  <qti-response-declaration identifier="PRIMES" cardinality="multiple" base-type="identifier">
    <qti-correct-response>
      <qti-value>SEVEN</qti-value>
      <qti-value>ELEVEN</qti-value>
    </qti-correct-response>
  </qti-response-declaration>
  <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float">
    <qti-default-value>
      <qti-value>0</qti-value>
    </qti-default-value>
  </qti-outcome-declaration>
  <qti-item-body>
    <qti-choice-interaction response-identifier="ANIMAL" max-choices="1">
      <qti-prompt>Which of these animals is a mammal?</qti-prompt>
      <qti-simple-choice identifier="DOLPHIN">Dolphin</qti-simple-choice>
      <qti-simple-choice identifier="TROUT">Trout</qti-simple-choice>
      <qti-simple-choice identifier="GECKO">Gecko</qti-simple-choice>
    </qti-choice-interaction>
    <qti-choice-interaction response-identifier="PRIMES" max-choices="0">
      <qti-prompt>Which of these numbers are prime?</qti-prompt>
      <qti-simple-choice identifier="SEVEN">Seven</qti-simple-choice>
      <qti-simple-choice identifier="NINE">Nine</qti-simple-choice>
      <qti-simple-choice identifier="ELEVEN">Eleven</qti-simple-choice>
    </qti-choice-interaction>
  </qti-item-body>
</qti-assessment-item>
