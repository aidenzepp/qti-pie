<?xml version="1.0" encoding="UTF-8"?>
<!-- A hand-written AfA PNP 3.0 profile that allows a candidate one and a half times the written testing time and names it in activate-at-initialization-set, so it is on at the start of the delivery. -->
<access-for-all-pnp xmlns="http://www.imsglobal.org/xsd/qti/qtiv3p0/imsafa3p0pnp_v1p0">
  <additional-testing-time>
    <time-multiplier>1.5</time-multiplier>
  </additional-testing-time>
  <activate-at-initialization-set>
    <additional-testing-time/>
  </activate-at-initialization-set>
</access-for-all-pnp>
