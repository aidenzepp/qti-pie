<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0_v1p0.xsd" identifier="sample-alf-order-text" title="ALF: on television" adaptive="false" time-dependent="false" xml:lang="en"><qti-response-declaration identifier="RESPONSE" cardinality="ordered" base-type="identifier"><qti-correct-response><qti-value>o1</qti-value><qti-value>o2</qti-value><qti-value>o3</qti-value><qti-value>o4</qti-value></qti-correct-response></qti-response-declaration><qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float"><qti-default-value><qti-value>0</qti-value></qti-default-value></qti-outcome-declaration><qti-outcome-declaration identifier="FEEDBACK" cardinality="single" base-type="identifier"/><qti-item-body><p>ALF was shown on NBC. A cartoon and a TV movie were made from it.</p><qti-order-interaction response-identifier="RESPONSE" shuffle="true" orientation="vertical" min-choices="4" max-choices="4"><qti-prompt><p>Put the events in order, from earliest to latest.</p></qti-prompt><qti-simple-choice identifier="o3">The last episode of ALF is shown (1990).</qti-simple-choice><qti-simple-choice identifier="o1">The first episode of ALF is shown (1986).</qti-simple-choice><qti-simple-choice identifier="o4">The TV movie Project: ALF is shown (1996).</qti-simple-choice><qti-simple-choice identifier="o2">ALF: The Animated Series begins (1987).</qti-simple-choice></qti-order-interaction></qti-item-body><qti-response-processing><qti-response-condition><qti-response-if><qti-and><qti-match><qti-variable identifier="RESPONSE"/><qti-correct identifier="RESPONSE"/></qti-match></qti-and><qti-set-outcome-value identifier="SCORE"><qti-base-value base-type="float">1</qti-base-value></qti-set-outcome-value><qti-set-outcome-value identifier="FEEDBACK"><qti-base-value base-type="identifier">correct</qti-base-value></qti-set-outcome-value></qti-response-if><qti-response-else><qti-set-outcome-value identifier="SCORE"><qti-base-value base-type="float">0</qti-base-value></qti-set-outcome-value><qti-set-outcome-value identifier="FEEDBACK"><qti-base-value base-type="identifier">incorrect</qti-base-value></qti-set-outcome-value></qti-response-else></qti-response-condition></qti-response-processing><qti-modal-feedback outcome-identifier="FEEDBACK" identifier="correct" show-hide="show"><qti-content-body><p>Correct. The show began in 1986, the cartoon began in 1987, the show ended in 1990, and the movie came in 1996.</p></qti-content-body></qti-modal-feedback><qti-modal-feedback outcome-identifier="FEEDBACK" identifier="incorrect" show-hide="show"><qti-content-body><p>Not quite. Use the years: 1986 (first episode), 1987 (cartoon begins), 1990 (last episode), 1996 (TV movie).</p></qti-content-body></qti-modal-feedback></qti-assessment-item>
