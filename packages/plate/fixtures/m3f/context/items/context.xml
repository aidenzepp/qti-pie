<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0"
  identifier="context" title="Who sits this item" adaptive="false" time-dependent="false">
  <qti-context-declaration identifier="ROOM" cardinality="single" base-type="integer">
    <qti-default-value>
      <qti-value>12</qti-value>
    </qti-default-value>
  </qti-context-declaration>
  <qti-response-declaration identifier="RESPONSE" cardinality="single" base-type="identifier">
    <qti-correct-response>
      <qti-value>NORTH</qti-value>
    </qti-correct-response>
  </qti-response-declaration>
  <qti-outcome-declaration identifier="SITTING" cardinality="single" base-type="string"/>
  <qti-template-declaration identifier="CANDIDATE" cardinality="single" base-type="string"/>
  <qti-template-declaration identifier="ENVIRONMENT" cardinality="single" base-type="string"/>
  <qti-template-declaration identifier="SEAT" cardinality="single" base-type="integer"/>
  <qti-template-processing>
    <qti-set-template-value identifier="CANDIDATE">
      <qti-field-value field-identifier="candidateIdentifier">
        <qti-variable identifier="QTI_CONTEXT"/>
      </qti-field-value>
    </qti-set-template-value>
    <qti-set-template-value identifier="ENVIRONMENT">
      <qti-field-value field-identifier="environmentIdentifier">
        <qti-variable identifier="QTI_CONTEXT"/>
      </qti-field-value>
    </qti-set-template-value>
    <qti-set-template-value identifier="SEAT">
      <qti-variable identifier="ROOM"/>
    </qti-set-template-value>
  </qti-template-processing>
  <qti-item-body>
    <qti-choice-interaction response-identifier="RESPONSE" shuffle="false" max-choices="1">
      <qti-prompt>Which way does the compass needle point?</qti-prompt>
      <qti-simple-choice identifier="NORTH">North</qti-simple-choice>
      <qti-simple-choice identifier="WEST">West</qti-simple-choice>
    </qti-choice-interaction>
  </qti-item-body>
  <qti-response-processing>
    <qti-set-outcome-value identifier="SITTING">
      <qti-field-value field-identifier="testIdentifier">
        <qti-variable identifier="QTI_CONTEXT"/>
      </qti-field-value>
    </qti-set-outcome-value>
  </qti-response-processing>
</qti-assessment-item>
