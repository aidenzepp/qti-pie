<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-test xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0"
  identifier="nested" title="Nested sections">
  <qti-test-part identifier="part" navigation-mode="nonlinear" submission-mode="individual">
    <qti-assessment-section identifier="outer" title="Outer section" visible="true">
      <qti-assessment-item-ref identifier="outer-first" href="choice.xml"/>
      <qti-assessment-section identifier="middle" title="Middle section" visible="true">
        <qti-assessment-item-ref identifier="middle-first" href="choice.xml"/>
        <qti-assessment-section identifier="inner" title="Inner section" visible="true">
          <qti-assessment-item-ref identifier="inner-first" href="choice.xml"/>
          <qti-assessment-item-ref identifier="inner-second" href="choice.xml"/>
        </qti-assessment-section>
        <qti-assessment-item-ref identifier="middle-last" href="choice.xml"/>
      </qti-assessment-section>
      <qti-assessment-item-ref identifier="outer-last" href="choice.xml"/>
    </qti-assessment-section>
    <qti-assessment-section identifier="after" title="A section after the nest" visible="true">
      <qti-assessment-item-ref identifier="after-only" href="choice.xml"/>
    </qti-assessment-section>
  </qti-test-part>
</qti-assessment-test>
