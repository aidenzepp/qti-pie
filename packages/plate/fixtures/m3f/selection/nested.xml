<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-test xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0"
  identifier="nested-selection" title="A selection over a sub-section">
  <qti-test-part identifier="part" navigation-mode="nonlinear" submission-mode="individual">
    <qti-assessment-section identifier="outer" title="Outer section" visible="true">
      <qti-selection select="1"/>
      <qti-assessment-section identifier="inner" title="Inner section" visible="true">
        <qti-selection select="1"/>
        <qti-assessment-item-ref identifier="inner-a" href="choice.xml"/>
        <qti-assessment-item-ref identifier="inner-b" href="choice.xml"/>
      </qti-assessment-section>
      <qti-assessment-item-ref identifier="solo" href="choice.xml"/>
    </qti-assessment-section>
  </qti-test-part>
</qti-assessment-test>
