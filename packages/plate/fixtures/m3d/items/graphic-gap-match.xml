<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0p1_v1p0.xsd"
  identifier="m3d-graphic-gap-match" title="Label the farm" adaptive="false" time-dependent="false">
  <qti-response-declaration identifier="RESPONSE" cardinality="multiple" base-type="directedPair">
    <qti-correct-response>
      <qti-value>A H1</qti-value>
      <qti-value>B H2</qti-value>
      <qti-value>C H3</qti-value>
    </qti-correct-response>
  </qti-response-declaration>
  <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float">
    <qti-default-value>
      <qti-value>0</qti-value>
    </qti-default-value>
  </qti-outcome-declaration>
  <qti-item-body>
    <qti-graphic-gap-match-interaction response-identifier="RESPONSE" max-associations="4">
      <qti-prompt>Put each label on the part of the farm it names.</qti-prompt>
      <img src="images/graphic-gap-match-map.svg" alt="A map of a farm with a square field, a round pond and a hill" width="400" height="300"/>
      <qti-gap-text identifier="A" match-max="2">Wheat field</qti-gap-text>
      <qti-gap-text identifier="B" match-max="1">Duck pond</qti-gap-text>
      <qti-gap-text identifier="C" match-max="1">Green hill</qti-gap-text>
      <qti-associable-hotspot identifier="H1" shape="rect" coords="40,40,180,130" match-max="2" hotspot-label="The square plot"/>
      <qti-associable-hotspot identifier="H2" shape="circle" coords="300,90,50" match-max="1" hotspot-label="The round water"/>
      <qti-associable-hotspot identifier="H3" shape="poly" coords="60,260,150,170,240,260" match-max="1" hotspot-label="The slope"/>
    </qti-graphic-gap-match-interaction>
  </qti-item-body>
  <qti-response-processing template="https://purl.imsglobal.org/spec/qti/v3p0/rptemplates/match_correct.xml"/>
</qti-assessment-item>
