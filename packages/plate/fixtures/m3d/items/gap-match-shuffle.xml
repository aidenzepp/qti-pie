<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0p1_v1p0.xsd"
  identifier="m3d-gap-match-shuffle" title="Shuffled words" adaptive="false" time-dependent="false">
  <qti-response-declaration identifier="RESPONSE" cardinality="multiple" base-type="directedPair">
    <qti-correct-response>
      <qti-value>A G1</qti-value>
      <qti-value>B G2</qti-value>
      <qti-value>C G3</qti-value>
    </qti-correct-response>
  </qti-response-declaration>
  <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float">
    <qti-default-value>
      <qti-value>0</qti-value>
    </qti-default-value>
  </qti-outcome-declaration>
  <qti-item-body>
    <qti-gap-match-interaction response-identifier="RESPONSE" shuffle="true" max-associations="3">
      <qti-gap-text identifier="A" match-max="1">oak</qti-gap-text>
      <qti-gap-text identifier="B" match-max="1">elm</qti-gap-text>
      <qti-gap-text identifier="C" match-max="1">ash</qti-gap-text>
      <qti-gap-text identifier="D" match-max="1">fir</qti-gap-text>
      <qti-gap-text identifier="E" match-max="1">yew</qti-gap-text>
      <qti-gap-text identifier="F" match-max="1">pine</qti-gap-text>
      <p>The grove holds <qti-gap identifier="G1"/>, <qti-gap identifier="G2"/> and <qti-gap identifier="G3"/>.</p>
    </qti-gap-match-interaction>
  </qti-item-body>
  <qti-response-processing template="https://purl.imsglobal.org/spec/qti/v3p0/rptemplates/match_correct.xml"/>
</qti-assessment-item>
