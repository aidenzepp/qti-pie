<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0p1_v1p0.xsd"
  identifier="pci-counter" title="Press counter" adaptive="false" time-dependent="false">
  <qti-response-declaration identifier="RESPONSE" cardinality="single" base-type="integer">
    <qti-correct-response>
      <qti-value>3</qti-value>
    </qti-correct-response>
  </qti-response-declaration>
  <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float">
    <qti-default-value>
      <qti-value>0</qti-value>
    </qti-default-value>
  </qti-outcome-declaration>
  <qti-item-body>
    <qti-portable-custom-interaction response-identifier="RESPONSE" module="counter"
      custom-interaction-type-identifier="urn:qti-pie:pci:counter"
      data-max-count="5" data-start_value-2="0">
      <qti-prompt>Press the button three times.</qti-prompt>
      <qti-interaction-modules primary-configuration="../modules/module_resolution.js">
        <qti-interaction-module id="counter" primary-path="../modules/counter"/>
      </qti-interaction-modules>
      <qti-interaction-markup>
        <p>Each press adds one to the count.</p>
        <template>
          <div class="counter-face">
            <span class="counter-value">0</span>
          </div>
        </template>
      </qti-interaction-markup>
    </qti-portable-custom-interaction>
  </qti-item-body>
  <qti-response-processing template="https://purl.imsglobal.org/spec/qti/v3p0/rptemplates/match_correct.xml"/>
</qti-assessment-item>
