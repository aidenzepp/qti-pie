<?xml version="1.0" encoding="UTF-8"?>
<!-- A hand-written AfA PNP 3.0 profile in the schema's spellings that names the same features as pnp-catalog.xml only in the set of features the candidate may turn on, so none is active at the start. -->
<access-for-all-pnp xmlns="http://www.imsglobal.org/xsd/qti/qtiv3p0/imsafa3p0pnp_v1p0">
  <activate-as-option-set>
    <additional-directions/>
    <keyboard-directions/>
    <linguistic-guidance/>
    <simplified-graphics/>
    <simplified-language-portions/>
    <keyword-translation/>
    <keyword-emphasis/>
    <captions/>
    <alternative-text/>
  </activate-as-option-set>
</access-for-all-pnp>
