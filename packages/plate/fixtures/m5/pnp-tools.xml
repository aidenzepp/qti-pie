<?xml version="1.0" encoding="UTF-8"?>
<!-- A hand-written AfA PNP 3.0 profile in the schema's spellings: every on-screen tool rows A-12 to A-45 name, the settings two of them take, and the hazard, input, translation and interface-language features. -->
<access-for-all-pnp xmlns="http://www.imsglobal.org/xsd/qti/qtiv3p0/imsafa3p0pnp_v1p0">
  <calculator-on-screen calculator-type="graphing"/>
  <homophone-checker-on-screen/>
  <line-reader highlight-color="#ffff00"/>
  <note-taking-on-screen/>
  <outliner-on-screen/>
  <peer-interaction-on-screen/>
  <spell-checker-on-screen/>
  <thesaurus-on-screen/>
  <visual-organizer-on-screen/>
  <hazard-avoidance>flashing</hazard-avoidance>
  <hazard-avoidance>ext:strobe</hazard-avoidance>
  <input-requirements>full-switch-control</input-requirements>
  <item-translation xml:lang="es"/>
  <language-of-interface xml:lang="fr"/>
  <activate-at-initialization-set>
    <calculator-on-screen/>
    <line-reader/>
  </activate-at-initialization-set>
</access-for-all-pnp>
