<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0p1_v1p0.xsd"
  identifier="m5-bidi-ruby" title="Bidirectional text and ruby" adaptive="false" time-dependent="false" xml:lang="en">
  <qti-response-declaration identifier="RESPONSE" cardinality="single" base-type="identifier">
    <qti-correct-response>
      <qti-value>B</qti-value>
    </qti-correct-response>
  </qti-response-declaration>
  <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float">
    <qti-default-value>
      <qti-value>0</qti-value>
    </qti-default-value>
  </qti-outcome-declaration>
  <qti-item-body>
    <p id="arabic" xml:lang="ar" dir="rtl">مرحبا بكم في الاختبار</p>
    <p id="name">The student <bdi id="student">Nadia al-Rashid</bdi> sat the test.</p>
    <p id="reversed">The code is <bdo id="code" dir="ltr">A-7-Q</bdo> in every language.</p>
    <p id="ruby">The kanji <ruby id="kanji"><rb>漢</rb><rp>(</rp><rt>kan</rt><rp>)</rp><rtc><rt>Chinese</rt></rtc></ruby> names a script.</p>
    <div id="rtl-block" dir="rtl">
      <qti-choice-interaction response-identifier="RESPONSE" max-choices="1">
        <qti-prompt>Which answer is second?</qti-prompt>
        <qti-simple-choice identifier="A">First</qti-simple-choice>
        <qti-simple-choice identifier="B">Second</qti-simple-choice>
        <qti-simple-choice identifier="C">Third</qti-simple-choice>
      </qti-choice-interaction>
    </div>
  </qti-item-body>
  <qti-response-processing template="https://purl.imsglobal.org/spec/qti/v3p0/rptemplates/match_correct.xml"/>
</qti-assessment-item>
