<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0p1_v1p0.xsd"
  identifier="m5-companion-materials" title="Measuring a desk" adaptive="false" time-dependent="false">
  <qti-response-declaration identifier="RESPONSE" cardinality="single" base-type="identifier">
    <qti-correct-response>
      <qti-value>B</qti-value>
    </qti-correct-response>
  </qti-response-declaration>
  <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float">
    <qti-default-value>
      <qti-value>0</qti-value>
    </qti-default-value>
  </qti-outcome-declaration>
  <qti-companion-materials-info>
    <qti-calculator>
      <qti-calculator-type>scientific</qti-calculator-type>
      <qti-description>A scientific calculator with trigonometric keys</qti-description>
    </qti-calculator>
    <qti-rule>
      <qti-description>A metric ruler for measuring the desk</qti-description>
      <qti-rule-system-si>
        <qti-minimum-length>30</qti-minimum-length>
        <qti-minor-increment unit="Millimeter">1</qti-minor-increment>
        <qti-major-increment unit="Centimeter">1</qti-major-increment>
      </qti-rule-system-si>
    </qti-rule>
    <qti-protractor>
      <qti-description>A protractor for measuring the corner</qti-description>
      <qti-increment-us>
        <qti-major-increment unit="Degree">1</qti-major-increment>
      </qti-increment-us>
    </qti-protractor>
    <qti-digital-material mime-type="application/pdf" label="Table of conversions">
      <qti-file-href>materials/table.pdf</qti-file-href>
      <qti-resource-icon>materials/table-icon.png</qti-resource-icon>
    </qti-digital-material>
    <qti-physical-material>A sheet of squared paper</qti-physical-material>
  </qti-companion-materials-info>
  <qti-item-body>
    <p>The desk is 1.2 metres wide.</p>
    <qti-choice-interaction response-identifier="RESPONSE" max-choices="1">
      <qti-prompt>How many centimetres is that?</qti-prompt>
      <qti-simple-choice identifier="A">12</qti-simple-choice>
      <qti-simple-choice identifier="B">120</qti-simple-choice>
      <qti-simple-choice identifier="C">1200</qti-simple-choice>
    </qti-choice-interaction>
  </qti-item-body>
  <qti-response-processing template="https://purl.imsglobal.org/spec/qti/v3p0/rptemplates/match_correct.xml"/>
</qti-assessment-item>
