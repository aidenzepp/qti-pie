{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "command": { "type": "string", "enum": ["import"] },
    "data": {
      "anyOf": [
        {
          "type": "object",
          "properties": { "package_id": { "type": "string" } },
          "required": ["package_id"],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "database_checked": { "type": "boolean", "enum": [false] },
            "dry_run": { "type": "boolean", "enum": [true] },
            "package_dir": { "type": "string" },
            "relations": {
              "anyOf": [
                { "type": "number" },
                { "type": "string", "enum": ["Infinity", "-Infinity", "NaN"] }
              ]
            },
            "rows": {
              "anyOf": [
                { "type": "number" },
                { "type": "string", "enum": ["Infinity", "-Infinity", "NaN"] }
              ]
            }
          },
          "required": ["database_checked", "dry_run", "package_dir", "relations", "rows"],
          "additionalProperties": true
        }
      ]
    },
    "ok": { "type": "boolean" },
    "schema_version": { "type": "number", "enum": [1] }
  },
  "required": ["command", "data", "ok", "schema_version"],
  "additionalProperties": true,
  "$defs": {}
}
