<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0_v1p0.xsd" identifier="undeclared-reference" title="P8: a reference to an undeclared identifier" adaptive="false" time-dependent="false">
    <qti-response-declaration identifier="RESPONSE" cardinality="single" base-type="identifier">
        <qti-correct-response>
            <qti-value>ChoiceA</qti-value>
        </qti-correct-response>
    </qti-response-declaration>
    <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float"/>
    <qti-item-body>
        <qti-choice-interaction response-identifier="RESPONSE" shuffle="false" max-choices="1">
            <qti-simple-choice identifier="ChoiceA">First</qti-simple-choice>
            <qti-simple-choice identifier="ChoiceB">Second</qti-simple-choice>
        </qti-choice-interaction>
    </qti-item-body>
    <qti-response-processing>
        <qti-set-outcome-value identifier="SCORE">
            <qti-variable identifier="MISSING"/>
        </qti-set-outcome-value>
    </qti-response-processing>
</qti-assessment-item>
