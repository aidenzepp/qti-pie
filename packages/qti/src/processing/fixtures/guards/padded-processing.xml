<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0_v1p0.xsd" identifier="padded-processing" title="Padded attribute values" adaptive="false" time-dependent="false">
    <qti-response-declaration identifier="R" cardinality="single" base-type="identifier">
        <qti-correct-response>
            <qti-value>ChoiceA</qti-value>
        </qti-correct-response>
    </qti-response-declaration>
    <qti-outcome-declaration identifier="FLAG" cardinality="single" base-type="boolean"/>
    <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float"/>
    <qti-outcome-declaration identifier="NOTE" cardinality="single" base-type="string"/>
    <qti-item-body>
        <p>Look at the text in the picture.</p>
        <p>
            <img src="images/sign.png" alt="NEVER LEAVE LUGGAGE UNATTENDED"/>
        </p>
        <qti-choice-interaction response-identifier="R" shuffle="false" max-choices="1">
            <qti-prompt>What does it say?</qti-prompt>
            <qti-simple-choice identifier="ChoiceA">You must stay with your luggage at all times.</qti-simple-choice>
            <qti-simple-choice identifier="ChoiceB">Do not let someone else look after your luggage.</qti-simple-choice>
        </qti-choice-interaction>
    </qti-item-body>
    <qti-response-processing>
        <qti-set-outcome-value identifier="FLAG">
            <qti-and>
                <qti-not>
                    <qti-is-null>
                        <qti-correct identifier=" R "/>
                    </qti-is-null>
                </qti-not>
                <qti-equal tolerance-mode="absolute" tolerance="0.5  1">
                    <qti-variable identifier="SCORE"/>
                    <qti-base-value base-type="float">1.25</qti-base-value>
                </qti-equal>
                <qti-string-match case-sensitive=" true">
                    <qti-variable identifier="NOTE"/>
                    <qti-base-value base-type="string">alpha</qti-base-value>
                </qti-string-match>
                <qti-equal-rounded rounding-mode="significantFigures" figures=" 3">
                    <qti-variable identifier="SCORE"/>
                    <qti-base-value base-type="float">1.234</qti-base-value>
                </qti-equal-rounded>
                <qti-pattern-match pattern=" a">
                    <qti-variable identifier="NOTE"/>
                </qti-pattern-match>
            </qti-and>
        </qti-set-outcome-value>
    </qti-response-processing>
</qti-assessment-item>
