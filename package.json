{
  "name": "qti-pie",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm run format && pnpm run lint && pnpm run typecheck",
    "format": "vp fmt --check",
    "lint": "vp lint --type-aware",
    "typecheck": "tsc --noEmit",
    "fix": "vp fmt && vp lint --fix",
    "test": "pnpm -r --workspace-concurrency=1 run test"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "ultracite": "7.12.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.16.1"
}
