#!/usr/bin/env bash
# vivi boot probe: the shared-resource budget of AGENTS.md ("Shared machine resources"), measured, so every
# `vivi boot` shows it. Read-only: it lists and sizes, and never removes anything. It prints one JSON object
# (facts, sections) and always exits 0; a measurement it cannot take is reported, not fatal.
set -uo pipefail
cd "$(dirname "$0")/.."

: "${GRIZZLE_PG_STATE:=$HOME/.local/var/grizzle/pg19rc1}"
: "${GRIZZLE_PG_BIN:=$HOME/.local/opt/postgresql/19rc1/bin}"
budget_kb=$((5 * 1024 * 1024))
worktree_limit=6

kb() { du -sk "$1" 2>/dev/null | cut -f1 || echo 0; }
human() { awk -v k="$1" 'BEGIN { split("KB MB GB TB", u); i = 1; while (k >= 1024 && i < 4) { k /= 1024; i++ } printf "%.1f %s", k, u[i] }'; }

facts=()
lines=()

# Worktrees: every one but the main checkout counts; any outside the two allowed homes is a breach.
root="$(pwd -P)"
worktrees=()
while IFS= read -r path; do
  [[ "$path" == "$root" ]] || worktrees+=("$path")
done < <(git worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p')
lines+=("worktrees ${#worktrees[@]} of at most $worktree_limit")
for path in "${worktrees[@]}"; do
  case "$path" in
    "$root/.worktrees/"* | "$root/.claude/worktrees/"*) lines+=("  $path") ;;
    *) lines+=("  OUTSIDE ALLOWED HOMES: $path") ;;
  esac
done
((${#worktrees[@]} > worktree_limit)) && facts+=("worktrees over the limit: ${#worktrees[@]} of $worktree_limit")
prunable=$(git worktree list --porcelain 2>/dev/null | grep -c '^prunable' || true)
((prunable > 0)) && facts+=("$prunable prunable worktree record(s): run git worktree prune")
worktree_kb=$(($(kb .worktrees) + $(kb .claude/worktrees)))

# Databases: gr8des_% on the shared cluster, by size.
db_kb=0
password_file="$GRIZZLE_PG_STATE/grizzle_dev.password"
if [[ -r "$password_file" ]]; then
  rows=$(PGPASSWORD="$(cat "$password_file")" PGCONNECT_TIMEOUT=3 "$GRIZZLE_PG_BIN/psql" -X -q -At -F ' ' \
    "host=localhost port=5433 dbname=postgres user=grizzle_dev sslmode=verify-full sslrootcert=$GRIZZLE_PG_STATE/tls/ca.crt" \
    -c "SELECT datname, pg_database_size(datname) / 1024 FROM pg_database WHERE datname LIKE 'gr8des%' ORDER BY 1" 2>&1)
  if [[ $? -eq 0 ]]; then
    count=0
    while read -r name size; do
      [[ -n "$name" ]] || continue
      count=$((count + 1))
      db_kb=$((db_kb + size))
      lines+=("  database $name $(human "$size")")
    done <<<"$rows"
    lines=("${lines[@]:0:1}" "databases $count on localhost:5433" "${lines[@]:1}")
  else
    facts+=("database cluster on localhost:5433 not reachable: start it with pnpm pg start in the grizzle clone")
  fi
else
  facts+=("no grizzle cluster credentials at $password_file")
fi

used_kb=$((worktree_kb + db_kb))
lines+=("budget $(human "$used_kb") of $(human "$budget_kb") (worktrees $(human "$worktree_kb"), databases $(human "$db_kb"))")
((used_kb > budget_kb)) && facts+=("OVER the 5 GB resource budget: $(human "$used_kb")")
lines+=("download cache ~/.cache/gr8des $(human "$(kb "$HOME/.cache/gr8des")")")
lines+=("disk free $(df -k "$HOME" | awk 'NR == 2 { print $4 }' | xargs -I{} awk -v k={} 'BEGIN { printf "%.0f GB", k / 1048576 }')")

jq -n --args '{facts: $ARGS.positional[0:($n | tonumber)], sections: [{title: "resources", lines: $ARGS.positional[($n | tonumber):]}]}' \
  --arg n "${#facts[@]}" "${facts[@]}" "${lines[@]}"
exit 0
